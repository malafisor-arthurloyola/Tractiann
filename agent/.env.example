# LLM — compatível com a API da OpenAI (Groq e OpenRouter usam esse mesmo formato)
OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b

# --- Fallback entre provedores -----------------------------------------------
# Quando o provedor principal estoura a cota (o Groq gratuito tem 200k tokens/dia)
# ou falha, a chamada CAI AUTOMATICAMENTE no proximo provedor configurado aqui.
# Numere a partir de 1, sem pular numeros. Vale qualquer gateway compativel com
# a API da OpenAI — OpenRouter, OpenAI, ou um roteador proprio.
#
# LLM_FALLBACK_1_API_KEY=sk-or-v1-sua_chave_openrouter
# LLM_FALLBACK_1_BASE_URL=https://openrouter.ai/api/v1
# LLM_FALLBACK_1_MODEL=meta-llama/llama-3.3-70b-instruct
#
# LLM_FALLBACK_2_API_KEY=...
# LLM_FALLBACK_2_BASE_URL=...
# LLM_FALLBACK_2_MODEL=...

# Endereço da API industrial Tractian (sobe com `make up`)
TRACTIAN_API_URL=http://localhost:8000

# Banco de dados do agente (log de execuções) — sobe com `make postgres-up`
DATABASE_URL=postgresql://tractian:tractian_dev@localhost:5432/tractian_agent

# Phoenix (tracing open source) — sobe com `make phoenix-up`
# Defina PHOENIX_ENABLED=1 para instrumentar
PHOENIX_ENABLED=0
PHOENIX_ENDPOINT=http://localhost:6006
